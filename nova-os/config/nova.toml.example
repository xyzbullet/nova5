# NovaOS workstation image configuration.
# Copy this file to build/nova.toml and adjust it for a target machine.

[system]
name = "NovaOS"
release_channel = "edge"
architecture = "amd64"
timezone = "UTC"

[desktop]
session = "nova"
display_server = "wayland"
audio_server = "pipewire"

[gaming]
enable_linux_runtime = true
enable_proton = true
enable_gamescope = true

[creative]
enable_realtime_audio = true
enable_gpu_compute = true
enable_color_management = true

[updates]
atomic = true
keep_snapshots = 3